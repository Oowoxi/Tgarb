javascript:(function(){
    if(window.isUltimateBotRunning) return;
    window.isUltimateBotRunning = true;

    // --- 1. إعداد واجهة الصفحة ---
    document.body.innerHTML = '';
    document.body.style.margin = '0';
    document.body.style.padding = '0';
    document.body.style.overflow = 'hidden';
    document.body.style.display = 'flex';
    document.body.style.flexDirection = 'column';
    document.body.style.height = '100vh';
    document.body.style.background = '#000'; 

    // --- 2. الشاشة العليا (الحساب الأساسي) ---
    let fMain = document.createElement('iframe');
    fMain.src = location.href;
    fMain.style.width = '100%';
    fMain.style.height = '40vh'; 
    fMain.style.border = 'none';
    document.body.appendChild(fMain);

    // --- 3. شريط السحب والتحكم بالحجم ---
    let divider = document.createElement('div');
    divider.style.cssText = 'height: 12px; background: #ffaa00; cursor: row-resize; touch-action: none; display: flex; justify-content: center; align-items: center; z-index: 999999; user-select: none; flex-shrink: 0;';
    divider.innerHTML = '<div style="width: 35px; height: 4px; background: #111; border-radius: 2px;"></div>';
    document.body.appendChild(divider);

    let botsContainer = document.createElement('div');
    botsContainer.style.flex = '1';
    botsContainer.style.display = 'flex';
    botsContainer.style.flexWrap = 'wrap'; 
    botsContainer.style.width = '100%';
    document.body.appendChild(botsContainer);

    // آلية سحب الشريط
    let isDragging = false;
    divider.addEventListener('mousedown', () => { isDragging = true; fMain.style.pointerEvents = 'none'; botsContainer.style.pointerEvents = 'none'; });
    divider.addEventListener('touchstart', () => { isDragging = true; }, {passive: true});
    window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        let percentage = (e.clientY / window.innerHeight) * 100;
        if (percentage > 10 && percentage < 90) fMain.style.height = percentage + 'vh';
    });
    window.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        let percentage = (e.touches[0].clientY / window.innerHeight) * 100;
        if (percentage > 10 && percentage < 90) fMain.style.height = percentage + 'vh';
    }, {passive: true});
    window.addEventListener('mouseup', () => { isDragging = false; fMain.style.pointerEvents = 'auto'; botsContainer.style.pointerEvents = 'auto'; });
    window.addEventListener('touchend', () => { isDragging = false; });

    // منع سكون الشاشة
    function keepAwake() {
        let audio = document.createElement('audio');
        audio.src = 'data:audio/wav;base64,UklGRigAAABXQVZFZm10IBIAAAABAAEARKwAAIhYAQACABAAAABkYXRhAgAAAAEA';
        audio.loop = true;
        let playAttempt = setInterval(() => { audio.play().then(() => clearInterval(playAttempt)).catch(() => {}); }, 1000);
    }
    keepAwake();

    // ==========================================
    // محرك الشاشة العليا (ضغط الخروج كل دقيقة قسرياً)
    // ==========================================
    function forceExitClick(){
        try {
            let d1 = fMain.contentDocument;
            if (!d1) return;
            let exitBtn = d1.querySelector('.fa-sign-out, .fa-sign-out-alt, .fa-door-open, [onclick*="exit"], [onclick*="leave"], [onclick*="logout"], .exit');
            if (exitBtn) {
                exitBtn.click();
                exitBtn.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
            }
        } catch(e){}
    }
    setTimeout(function(){
        forceExitClick();
        setInterval(forceExitClick, 60 * 1000);
    }, 25000);

    // ==========================================
    // إنشاء الإطارات السفلية مع (العزل البرمجي للذاكرة)
    // ==========================================
    function createIsolatedFrame() {
        let f = document.createElement('iframe');
        f.src = location.href;
        f.style.width = '50%'; 
        f.style.height = '50%'; 
        f.style.border = '1px solid #222';
        f.style.boxSizing = 'border-box';
        botsContainer.appendChild(f);

        // حقن ذاكرة وهمية لمنع تضارب الجلسات (Session Isolation)
        let isolatedStorage = {};
        f.addEventListener('load', function() {
            try {
                let w = f.contentWindow;
                let proxy = {
                    getItem: k => isolatedStorage[k] || null,
                    setItem: (k, v) => { isolatedStorage[k] = String(v); },
                    removeItem: k => { delete isolatedStorage[k]; },
                    clear: () => { isolatedStorage = {}; },
                    get length() { return Object.keys(isolatedStorage).length; },
                    key: i => Object.keys(isolatedStorage)[i] || null
                };
                Object.defineProperty(w, 'localStorage', { value: proxy, writable: false });
                Object.defineProperty(w, 'sessionStorage', { value: proxy, writable: false });
            } catch(e) {}
        });

        return f;
    }

    let botFrames = [];
    for(let i = 0; i < 4; i++) {
        botFrames.push(createIsolatedFrame());
    }

    // ==========================================
    // محرك البوت (الخروج الصامت + التأخير المتبادل)
    // ==========================================
    function initBotLogic(frame, startDelayMs) {
        let step = 0;
        // إضافة التأخير المتبادل (Staggering) لتفادي Error 1015
        let lastTime = Date.now() + startDelayMs; 
        let lastProgress = Date.now();

        function getRandomDelay(base) { return base + Math.floor(Math.random() * 500); }
        function fire(el){ el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true })); }
        function visible(d, sel){ return Array.from(d.querySelectorAll(sel)).filter(el => el.offsetParent !== null); }

        // الخروج الصامت لمنع الإطار من عمل ريفريش كامل
        function installSoftLogout(w){
            if (!w || w.__softLogoutInstalled) return;
            w.__softLogoutInstalled = true;
            try { w.__botLoginTab = (w.$ && w.$('#l2').length && w.$('#l2').is(':visible')) ? '#l2' : '#l1'; } catch(e){ w.__botLoginTab = '#l1'; }
            var origLogout = (typeof w.logout === 'function') ? w.logout : null;

            w.logout = function(){
                var oReload = w.location.reload, oReplace = w.location.replace, oAssign = w.location.assign;
                var locked = true;
                try { w.location.reload = function(){ if (locked) return false; }; } catch(e){}
                try { w.location.replace = function(){ if (locked) return false; }; } catch(e){}
                try { w.location.assign = function(){ if (locked) return false; }; } catch(e){}
                try { if (origLogout) origLogout(); } catch(e){}

                try { var m = w.TH_CHAT_RECONNECT_MANAGER_INSTANCE; if (m && m.core && m.core.markIntentionalClose) m.core.markIntentionalClose(true); } catch(e){}
                try { if (typeof w.TH_MARK_INTENTIONAL_DISCONNECT_TIGERHOST === 'function') w.TH_MARK_INTENTIONAL_DISCONNECT_TIGERHOST(true); } catch(e){}
                try { if (w.x_x && typeof w.x_x.disconnect === 'function') w.x_x.disconnect(); } catch(e){}
                try { if (w.x_x && typeof w.x_x.close === 'function') w.x_x.close(); } catch(e){}
                
                setTimeout(function(){
                    locked = false;
                    try { w.location.reload = oReload; } catch(e){}
                    try { w.location.replace = oReplace; } catch(e){}
                    try { w.location.assign = oAssign; } catch(e){}
                    try { if (w.$) w.$('.nav-tabs a[href="' + (w.__botLoginTab || '#l1') + '"]').tab('show'); } catch(e){}
                    try {
                        var d = w.document;
                        var closePanel = d.querySelector('#dpnl .fa-close') || d.querySelector('#dpnl .thMorePaneBackBtn');
                        if (closePanel) closePanel.click();
                    } catch(e){}
                }, 1000);
            };
        }

        function runBot(){
            let now = Date.now();
            if (now < lastTime) return; // انتظار وقت البدء المتبادل

            try {
                let w = frame.contentWindow;
                let d = frame.contentDocument;
                if (!w || !d) return;

                if (d.body) {
                    let pageText = d.body.innerText || "";
                    if ((pageText.includes('Error 1015') || pageText.includes('rate limited')) && step !== 99) {
                        step = 99; lastTime = now; lastProgress = now;
                        setTimeout(() => { try { frame.src = location.href; } catch(e){} step = 0; lastTime = Date.now(); lastProgress = Date.now(); }, 15000);
                        return;
                    }
                    if (step === 99) return;
                }

                if (step === 0 && (now - lastTime > 5000)) {
                    let eyeBtn = d.querySelector('.fa-eye') || d.querySelector('#stealth-btn');
                    if (eyeBtn && eyeBtn.offsetParent !== null) eyeBtn.click();
                    installSoftLogout(w);
                    step = 2; lastTime = now; lastProgress = now;
                }
                else if (step === 2 && (now - lastTime > getRandomDelay(800))) {
                    let loginBtn = Array.from(d.querySelectorAll('.th-login-btn')).find(el => el.offsetParent !== null);
                    if (loginBtn) { loginBtn.click(); step = 3; lastTime = now; lastProgress = now; }
                }
                else if (step === 3 && (now - lastTime > getRandomDelay(2000))) {
                    let usersBtn = d.querySelector('.th-d0-users');
                    if (usersBtn && usersBtn.offsetParent !== null) { usersBtn.click(); step = 4; lastTime = now; lastProgress = now; }
                }
                else if (step === 4 && (now - lastTime > getRandomDelay(700))) {
                    let si = d.getElementById('usearch');
                    if (si && si.offsetParent !== null) { si.value = "87"; fire(si); step = 5; lastTime = now; lastProgress = now; }
                }
                else if (step === 5 && (now - lastTime > getRandomDelay(700))) {
                    let us = visible(d, '#users .uzr.uhtml');
                    if (us.length > 0) { us[0].click(); step = 6; lastTime = now; lastProgress = now; }
                }
                else if (step === 6 && (now - lastTime > getRandomDelay(700))) {
                    let cb = d.querySelector('#upro .fa-times');
                    if (cb && cb.offsetParent !== null) { cb.click(); step = 7; lastTime = now; lastProgress = now; }
                }
                else if (step === 7 && (now - lastTime > getRandomDelay(500))) {
                    let sb = d.querySelector('.th-d0-settings');
                    if (sb && sb.offsetParent !== null) { sb.click(); step = 8; lastTime = now; lastProgress = now; }
                }
                else if (step === 8 && (now - lastTime > getRandomDelay(500))) {
                    let lb = d.querySelector('label.SERT');
                    if (lb && lb.offsetParent !== null) { lb.click(); } else if (typeof w.logout === 'function') { w.logout(); }
                    step = 9; lastTime = now; lastProgress = now;
                }
                else if (step === 9 && (now - lastTime > getRandomDelay(8000))) {
                    step = 2; lastTime = now; lastProgress = now;
                }
            } catch(e){}
        }

        setInterval(function(){
            if (Date.now() - lastProgress > 45000 && step !== 99) {
                try { frame.src = location.href; } catch(e){}
                step = 0; lastTime = Date.now(); lastProgress = Date.now();
            }
        }, 2000);

        setInterval(runBot, 100);
    }

    // تفعيل الإطارات بفارق 4 ثواني بين كل إطار (Staggering)
    botFrames.forEach((frame, index) => {
        initBotLogic(frame, index * 4000); // 0 ثانية، 4 ثواني، 8 ثواني، 12 ثانية
    });

})();
