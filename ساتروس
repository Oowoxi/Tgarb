javascript:(function(){
    if(window.isAutoBotRunning) return;
    window.isAutoBotRunning = true;

    document.body.innerHTML = '';
    document.body.style.margin = '0';
    document.body.style.overflow = 'hidden';

    let iframe = document.createElement('iframe');
    iframe.src = location.href;
    iframe.style.width = '100vw';
    iframe.style.height = '100vh';
    iframe.style.border = 'none';
    document.body.appendChild(iframe);

    // --- 1. حيلة الصوت الصامت لمنع السكون العميق ---
    function keepAwake() {
        let audio = document.createElement('audio');
        // ملف WAV صامت ومدمج
        audio.src = 'data:audio/wav;base64,UklGRigAAABXQVZFZm10IBIAAAABAAEARKwAAIhYAQACABAAAABkYXRhAgAAAAEA';
        audio.loop = true;
        
        let playAttempt = setInterval(() => {
            audio.play().then(() => {
                console.log('الصوت الصامت شغال، المتصفح لن ينام!');
                clearInterval(playAttempt);
            }).catch(() => {
                // ننتظر لمسة المستخدم للشاشة
            });
        }, 1000);
    }
    keepAwake();

    // --- 2. واجهة منع قفل الشاشة (Wake Lock API) ---
    if ('wakeLock' in navigator) {
        let wakeLock = null;
        const requestWakeLock = async () => {
            try {
                wakeLock = await navigator.wakeLock.request('screen');
                console.log('تم تفعيل منع السكون للشاشة');
            } catch (err) {
                console.log('فشل تفعيل منع السكون: ' + err.name);
            }
        };
        requestWakeLock();
        
        // إعادة التفعيل في حال فقدان التركيز على المتصفح
        document.addEventListener('visibilitychange', () => {
            if (wakeLock !== null && document.visibilityState === 'visible') {
                requestWakeLock();
            }
        });
    }

    let step = 0;
    let lastTime = Date.now();
    let lastProgress = Date.now();

    function W(){ try { return iframe.contentWindow; } catch(e){ return null; } }
    function D(){ try { return iframe.contentWindow.document; } catch(e){ return null; } }

    function fire(el){
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true }));
    }
    function visible(d, sel){
        return Array.from(d.querySelectorAll(sel)).filter(el => el.offsetParent !== null);
    }

    // ====== تسجيل خروج صامت ======
    function installSoftLogout(w){
        if (!w || w.__softLogoutInstalled) return;
        w.__softLogoutInstalled = true;

        try {
            w.__botLoginTab = (w.$ && w.$('#l2').length && w.$('#l2').is(':visible')) ? '#l2' : '#l1';
        } catch(e){ w.__botLoginTab = '#l1'; }

        var origLogout = (typeof w.logout === 'function') ? w.logout : null;

        w.logout = function(){
            var oReload = w.location.reload, oReplace = w.location.replace, oAssign = w.location.assign;
            var locked = true;
            try { w.location.reload  = function(){ if (locked) return false; }; } catch(e){}
            try { w.location.replace = function(){ if (locked) return false; }; } catch(e){}
            try { w.location.assign = function(){ if (locked) return false; }; } catch(e){}

            try { if (origLogout) origLogout(); } catch(e){}

            try {
                var m = w.TH_CHAT_RECONNECT_MANAGER_INSTANCE;
                if (m && m.core && m.core.markIntentionalClose) m.core.markIntentionalClose(true);
            } catch(e){}
            try { if (typeof w.TH_MARK_INTENTIONAL_DISCONNECT_TIGERHOST === 'function') w.TH_MARK_INTENTIONAL_DISCONNECT_TIGERHOST(true); } catch(e){}
            try { if (w.x_x && typeof w.x_x.disconnect === 'function') w.x_x.disconnect(); } catch(e){}
            try { if (w.x_x && typeof w.x_x.close === 'function') w.x_x.close(); } catch(e){}
            try { w.MY_T = ''; } catch(e){}
            try { w.TIGERHOST = null; } catch(e){}
            try { w.M_ROOM = null; } catch(e){}

            setTimeout(function(){
                locked = false;
                try { w.location.reload  = oReload; } catch(e){}
                try { w.location.replace = oReplace; } catch(e){}
                try { w.location.assign = oAssign; } catch(e){}
                try {
                    if (w.$) {
                        w.$('.nav-tabs a[href="' + (w.__botLoginTab || '#l1') + '"]').tab('show');
                    }
                } catch(e){}
                try {
                    var d = w.document;
                    var closePanel = d.querySelector('#dpnl .fa-close') || d.querySelector('#dpnl .thMorePaneBackBtn');
                    if (closePanel) closePanel.click();
                } catch(e){}
            }, 1000);
        };
    }

    function runBot(){
        try {
            let w = W();
            let d = D();
            if (!w || !d) return;
            let now = Date.now();

            // ====== 1. حل مشكلة كلاود فلاير (Error 1015) ======
            if (d.body) {
                let pageText = d.body.innerText || "";
                if ((pageText.includes('Error 1015') || pageText.includes('rate limited')) && step !== 99) {
                    step = 99; 
                    lastTime = now;
                    lastProgress = now;
                    
                    setTimeout(() => {
                        try { iframe.src = location.href; } catch(e){}
                        step = 0; 
                        lastTime = Date.now();
                        lastProgress = Date.now();
                    }, 10000); 
                    return;
                }
                if (step === 99) return; 
            }

            // 0. الانتظار 5 ثوانٍ
            if (step === 0 && (now - lastTime > 5000)) {
                let eyeBtn = d.querySelector('.fa-eye') || d.querySelector('#stealth-btn');
                if (eyeBtn && eyeBtn.offsetParent !== null) eyeBtn.click();
                installSoftLogout(w);
                step = 2;
                lastTime = now;
                lastProgress = now;
            }
            // 2. الضغط على زر الدخول
            else if (step === 2 && (now - lastTime > 500)) {
                let loginBtn = Array.from(d.querySelectorAll('.th-login-btn')).find(el => el.offsetParent !== null);
                if (loginBtn) {
                    loginBtn.click();
                    step = 3;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 3. فتح قائمة المستخدمين
            else if (step === 3 && (now - lastTime > 4000)) {
                let usersBtn = d.querySelector('.th-d0-users');
                if (usersBtn) {
                    usersBtn.click();
                    step = 4;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 4. البحث عن العضوية 87
            else if (step === 4 && (now - lastTime > 300)) {
                let si = d.getElementById('usearch');
                if (si) {
                    si.value = "87";
                    fire(si);
                    step = 5;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 5. فتح بروفايل 87
            else if (step === 5 && (now - lastTime > 500)) {
                let us = visible(d, '#users .uzr.uhtml');
                if (us.length > 0) {
                    us[0].click();
                    step = 6;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 6. إغلاق بروفايل 87
            else if (step === 6 && (now - lastTime > 500)) {
                let cb = d.querySelector('#upro .fa-times');
                if (cb) cb.click();
                step = 7;
                lastTime = now;
                lastProgress = now;
            }
            // 7. حذف البحث (مسح 87)
            else if (step === 7 && (now - lastTime > 300)) {
                let si = d.getElementById('usearch');
                if (si) {
                    si.value = "";
                    fire(si);
                    step = 8;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 8. البحث عن العضوية 30
            else if (step === 8 && (now - lastTime > 300)) {
                let si = d.getElementById('usearch');
                if (si) {
                    si.value = "30";
                    fire(si);
                    step = 9;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 9. فتح بروفايل 30
            else if (step === 9 && (now - lastTime > 500)) {
                let us = visible(d, '#users .uzr.uhtml');
                if (us.length > 0) {
                    us[0].click();
                    step = 10;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 10. إغلاق بروفايل 30
            else if (step === 10 && (now - lastTime > 500)) {
                let cb = d.querySelector('#upro .fa-times');
                if (cb) cb.click();
                step = 11;
                lastTime = now;
                lastProgress = now;
            }
            // 11. حذف البحث (مسح 30)
            else if (step === 11 && (now - lastTime > 300)) {
                let si = d.getElementById('usearch');
                if (si) {
                    si.value = "";
                    fire(si);
                    step = 12;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 12. البحث عن العضوية 75
            else if (step === 12 && (now - lastTime > 300)) {
                let si = d.getElementById('usearch');
                if (si) {
                    si.value = "75";
                    fire(si);
                    step = 13;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 13. فتح بروفايل 75
            else if (step === 13 && (now - lastTime > 500)) {
                let us = visible(d, '#users .uzr.uhtml');
                if (us.length > 0) {
                    us[0].click();
                    step = 14;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 14. إغلاق بروفايل 75
            else if (step === 14 && (now - lastTime > 500)) {
                let cb = d.querySelector('#upro .fa-times');
                if (cb) cb.click();
                step = 15;
                lastTime = now;
                lastProgress = now;
            }
            // 15. فتح الإعدادات
            else if (step === 15 && (now - lastTime > 300)) {
                let sb = d.querySelector('.th-d0-settings');
                if (sb) {
                    sb.click();
                    step = 16;
                    lastTime = now;
                    lastProgress = now;
                }
            }
            // 16. تسجيل خروج صامت
            else if (step === 16 && (now - lastTime > 300)) {
                let lb = d.querySelector('label.SERT');
                if (lb) {
                    lb.click(); 
                } else if (typeof w.logout === 'function') {
                    w.logout();
                }
                step = 17;
                lastTime = now;
                lastProgress = now;
            }
            // 17. العودة لشاشة الدخول وبدء دورة جديدة
            else if (step === 17 && (now - lastTime > 1500)) {
                step = 2;
                lastTime = now;
                lastProgress = now;
            }
        } catch(e) {}
    }

    setInterval(function(){
        if (Date.now() - lastProgress > 30000 && step !== 99) {
            try {
                iframe.src = location.href;   
            } catch(e){}
            step = 0;
            lastTime = Date.now();
            lastProgress = Date.now();
        }
    }, 2000);

    setInterval(runBot, 100);
    
    // تعديل رسالة التنبيه لتذكيرك بلمس الشاشة
    let alertMsg = 'تم تشغيل البوت بنجاح!\n\n';
    alertMsg += '⚠️ تنبيه هام: المس أي مكان في الشاشة الآن لمرة واحدة فقط لتفعيل الصوت الصامت، بعدها يمكنك قفل الجوال براحتك.';
    alert(alertMsg);
})();
