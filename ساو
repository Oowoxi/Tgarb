javascript:(function(){
    if(window.isAutoBotRunning) return;
    window.isAutoBotRunning = true;

    document.body.innerHTML = '';
    document.body.style.margin = '0';
    document.body.style.overflow = 'hidden';

    var iframe = document.createElement('iframe');
    iframe.src = location.href;
    iframe.style.width = '100vw';
    iframe.style.height = '100vh';
    iframe.style.border = 'none';
    document.body.appendChild(iframe);

    var TARGET1 = "87";
    var TARGET2 = "30";
    var step = 0;
    var lastTime = Date.now();
    var lastProgress = Date.now();
    var lastClick = 0;
    var deadline = 0;

    function W(){ try { return iframe.contentWindow; } catch(e){ return null; } }
    function D(){ try { return iframe.contentWindow.document; } catch(e){ return null; } }
    function vis(el){ return !!(el && el.offsetParent !== null); }
    function log(m){ try { console.log('[BOT] ' + m); } catch(e){} }

    // ====== كتابة البحث + إطلاق كل الأحداث ======
    function setSearch(w, d, val){
        var si = d.getElementById('usearch');
        if (!si) return false;
        si.value = val;
        try { si.dispatchEvent(new Event('input',  { bubbles: true })); } catch(e){}
        try { si.dispatchEvent(new Event('change', { bubbles: true })); } catch(e){}
        try { si.dispatchEvent(new KeyboardEvent('keydown', { bubbles: true })); } catch(e){}
        try { si.dispatchEvent(new KeyboardEvent('keyup',   { bubbles: true })); } catch(e){}
        try { if (w.$) w.$('#usearch').trigger('input').trigger('change').trigger('keyup'); } catch(e){}
        return true;
    }

    // ====== هل أنا داخل الشات؟ ======
    function isLoggedIn(d){
        var ub = d.querySelector('.th-d0-users');
        if (ub && ub.offsetParent !== null) return true;
        var tl = d.getElementById('tlogins');
        if (!tl) return false;
        if (tl.style && tl.style.display === 'none') return true;
        if (tl.offsetParent === null) return true;
        return false;
    }

    // ====== هل قائمة المستخدمين مفتوحة؟ ======
    function usersOpen(d){
        var si = d.getElementById('usearch');
        return !!(si && si.offsetParent !== null);
    }

    // ====== هل البروفايل مفتوح؟ ======
    function profileOpen(d){
        var up = d.getElementById('upro');
        if (!up) return false;
        return (up.offsetParent !== null);
    }

    // ====== إيجاد صف المستخدم: مطابقة مرنة، وإن لم توجد → أول نتيجة ظاهرة ======
    function findUserRow(d, target){
        var rows = d.querySelectorAll('#users .uzr.uhtml');
        var firstVisible = null;
        for (var i = 0; i < rows.length; i++){
            var r = rows[i];
            if (r.offsetParent === null) continue;
            if (!firstVisible) firstVisible = r;
            var txt = '';
            try {
                var he = r.querySelector('.uhashe'); if (he) txt += ' ' + he.textContent;
                var h  = r.querySelector('.uhash');  if (h)  txt += ' ' + h.textContent;
                var t  = r.querySelector('.u-topic'); if (t) txt += ' ' + t.textContent;
            } catch(e){}
            var lid = r.getAttribute('data-lid') || '';
            if (lid === target || txt.indexOf(target) !== -1) return r;
        }
        return firstVisible;
    }

    // ====== التحصين: منع أي تحديث/تنقل للصفحة نهائياً ======
    function installHardening(w){
        if (!w || w.__botHardened) return;
        w.__botHardened = true;

        var noop = function(){ return false; };
        try { w.location.reload  = noop; } catch(e){}
        try { w.location.replace = noop; } catch(e){}
        try { w.location.assign  = noop; } catch(e){}
        try {
            var proto = Object.getPrototypeOf(w.location);
            var desc = Object.getOwnPropertyDescriptor(proto, 'href');
            if (desc && desc.set) {
                Object.defineProperty(w.location, 'href', {
                    get: function(){ return desc.get.call(w.location); },
                    set: function(){},
                    configurable: true
                });
            }
        } catch(e){}
        try { w.open = function(){ return null; }; } catch(e){}
        try { w.history.forward = noop; w.history.back = noop; w.history.go = function(){ return null; }; } catch(e){}

        // توجيه زر الخروج إلى الخروج الصامت
        w.__botSoftLogout = function(){ return softLogout(w); };
        try { w.logout = w.__botSoftLogout; } catch(e){}
    }

    // ====== إعادة تفعيل السوكت قبل الدخول ======
    function rearmSocket(w){
        try {
            var m = w.TH_CHAT_RECONNECT_MANAGER_INSTANCE;
            if (!m && w.TH_XT_GET_RECONNECT_MANAGER) { try { m = w.TH_XT_GET_RECONNECT_MANAGER(); } catch(e){} }
            if (m && m.core && m.core.markIntentionalClose) m.core.markIntentionalClose(false);
            if (m && m.hooks && m.hooks.markIntentionalDisconnect) m.hooks.markIntentionalDisconnect(false);
        } catch(e){}
        try { if (w.x_x && typeof w.x_x.connect === 'function' && !w.x_x.connected) w.x_x.connect(); } catch(e){}
    }

    // ====== إظهار شاشة الدخول بدون أي تحديث (مع تنظيف طبقات إعادة الاتصال) ======
    function showLogin(w){
        var d;
        try { d = w.document; } catch(e){ return; }

        // 1) إزالة طبقة إعادة الاتصال (اللي تسبب الشاشة البيضاء) عبر دالة الموقع إن وُجدت
        try { if (typeof w.TH_FORCE_CLEAR_RECONNECT_OVERLAY_TIGERHOST === 'function') w.TH_FORCE_CLEAR_RECONNECT_OVERLAY_TIGERHOST(); } catch(e){}
        // 2) إزالة كل طبقات التغطية يدوياً
        try {
            if (w.$){
                w.$('.ovr').remove();
                w.$('#TH_OVR_V3').remove();
                w.$('#TH_CONN_OVERLAY').remove();
                w.$('.th-conn-overlay').remove();
            }
        } catch(e){}
        // 3) إعادة تفعيل الحقول اللي عطلتها الطبقة
        try { if (w.$) w.$('.box_text, textarea, input[type="text"]').prop('disabled', false).css({'pointer-events':'','opacity':''}); } catch(e){}
        // 4) إظهار شاشة الدخول
        try {
            var tl = d.getElementById('tlogins');
            if (tl){ tl.style.display='block'; tl.style.visibility='visible'; tl.style.opacity='1'; }
        } catch(e){}
        try { if (w.$) w.$('#tlogins').show(); } catch(e){}
        // 5) إخفاء واجهات الشات عشان شاشة الدخول تظهر نظيفة
        try { if (w.$) w.$('#dpnl, #d2, #d0, #d2bc, #wall, #borderbackground').hide(); } catch(e){}
        // 6) تبويب الدخول كضيف
        try { if (w.$) w.$('.nav-tabs a[href="#l1"]').tab('show'); } catch(e){}
    }

    // ====== خروج صامت: يرسل للسيرفر أنك طلعت + يرجع شاشة الدخول بدون تحديث ======
    function softLogout(w){
        log('logout start');
        var d = w.document;
        // منع إعادة الاتصال
        try {
            var m = w.TH_CHAT_RECONNECT_MANAGER_INSTANCE;
            if (!m && w.TH_XT_GET_RECONNECT_MANAGER) { try { m = w.TH_XT_GET_RECONNECT_MANAGER(); } catch(e){} }
            if (m && m.core && m.core.markIntentionalClose) m.core.markIntentionalClose(true);
            if (m && m.hooks && m.hooks.markIntentionalDisconnect) m.hooks.markIntentionalDisconnect(true);
        } catch(e){}
        try { if (typeof w.TH_MARK_INTENTIONAL_DISCONNECT_TIGERHOST === 'function') w.TH_MARK_INTENTIONAL_DISCONNECT_TIGERHOST(true); } catch(e){}
        // إشارة خروج للسيرفر ثم فصل السوكت
        try { if (w.x_x && w.x_x.emit) w.x_x.emit('logout', {}); } catch(e){}
        try { if (w.x_x && w.x_x.disconnect) w.x_x.disconnect(); } catch(e){}
        try { if (w.x_x && w.x_x.close) w.x_x.close(); } catch(e){}
        // مسح الجلسة
        try { w.MY_T=''; w.MY_CP=''; w.TIGERHOST=null; w.M_ROOM=null; } catch(e){}
        try { w.U_CASH={}; w.U_X={}; w.U_XR={}; w.TH_ROOM_CACHE={}; } catch(e){}
        try { if (w.setv) w.setv('token',''); } catch(e){}
        try { if (w.setxv) w.setxv('token',''); } catch(e){}
        try { if (w.localStorage){ w.localStorage.removeItem('token'); w.localStorage.removeItem('t'); } } catch(e){}
        try { if (w.sessionStorage) w.sessionStorage.clear(); } catch(e){}
        // إظهار شاشة الدخول (مرة فورية ومرة ثانية للتأكيد)
        showLogin(w);
        setTimeout(function(){ showLogin(w); }, 1200);
        log('logout done');
        return false;
    }

    function runBot(){
        try {
            var w = W();
            var d = D();
            if (!w || !d) return;
            var now = Date.now();

            // 0) انتظار التحميل ثم التحصين
            if (step === 0){
                if (now - lastTime > 5000){
                    var eye = d.querySelector('.fa-eye') || d.querySelector('#stealth-btn');
                    if (eye && vis(eye)) eye.click();
                    installHardening(w);
                    step = 2; lastTime = now; deadline = 0; lastProgress = now; log('started');
                }
                return;
            }
            // 2) الدخول
            if (step === 2){
                if (isLoggedIn(d)){
                    step = 3; lastTime = now; deadline = 0; lastProgress = now;
                } else {
                    if (now - lastClick > 1500){
                        rearmSocket(w);
                        var btn = Array.prototype.slice.call(d.querySelectorAll('.th-login-btn')).filter(vis)[0];
                        if (btn){ btn.click(); lastClick = now; lastProgress = now; log('click login'); }
                    }
                }
                return;
            }
            // 3) فتح قائمة المستخدمين
            if (step === 3){
                if (!isLoggedIn(d)){ step = 2; lastTime = now; deadline = 0; lastProgress = now; return; }
                if (usersOpen(d)){
                    step = 4; lastTime = now; deadline = 0; lastProgress = now;
                } else {
                    if (now - lastClick > 800){
                        var ub = d.querySelector('.th-d0-users');
                        if (ub){ ub.click(); lastClick = now; lastProgress = now; }
                    }
                }
                return;
            }
            // 4) البحث عن 87
            if (step === 4){
                if (!isLoggedIn(d)){ step = 2; lastTime = now; deadline = 0; lastProgress = now; return; }
                if (!usersOpen(d)){ step = 3; lastTime = now; deadline = 0; lastProgress = now; return; }
                setSearch(w, d, TARGET1);
                step = 5; lastTime = now; deadline = now + 2500; lastProgress = now; log('search 87');
                return;
            }
            // 5) انتظار الفلترة ثم فتح بروفايل 87
            if (step === 5){
                if (!isLoggedIn(d)){ step = 2; lastTime = now; deadline = 0; lastProgress = now; return; }
                if (now - lastTime < 900) return;
                var row = findUserRow(d, TARGET1);
                if (row){
                    row.click();
                    step = 6; lastTime = now; deadline = now + 2500; lastProgress = now; log('open 87');
                } else if (now > deadline){
                    setSearch(w, d, '');
                    step = 7; lastTime = now; deadline = 0; lastProgress = now; log('87 skip');
                }
                return;
            }
            // 6) إغلاق بروفايل 87
            if (step === 6){
                if (profileOpen(d)){
                    if (now - lastTime > 400){
                        var cb = d.querySelector('#upro .fa-times');
                        if (cb) cb.click();
                        try { if (w.$) w.$('#upro').modal('hide'); } catch(e){}
                        step = 7; lastTime = now; deadline = 0; lastProgress = now; log('close 87');
                    }
                } else if (now > deadline){
                    step = 7; lastTime = now; deadline = 0; lastProgress = now;
                }
                return;
            }
            // 7) مسح البحث
            if (step === 7){
                setSearch(w, d, '');
                step = 8; lastTime = now; deadline = 0; lastProgress = now; log('clear');
                return;
            }
            // 8) البحث عن 30
            if (step === 8){
                if (!isLoggedIn(d)){ step = 2; lastTime = now; deadline = 0; lastProgress = now; return; }
                if (!usersOpen(d)){ step = 3; lastTime = now; deadline = 0; lastProgress = now; return; }
                setSearch(w, d, TARGET2);
                step = 9; lastTime = now; deadline = now + 2500; lastProgress = now; log('search 30');
                return;
            }
            // 9) انتظار الفلترة ثم فتح بروفايل 30
            if (step === 9){
                if (!isLoggedIn(d)){ step = 2; lastTime = now; deadline = 0; lastProgress = now; return; }
                if (now - lastTime < 900) return;
                var row2 = findUserRow(d, TARGET2);
                if (row2){
                    row2.click();
                    step = 10; lastTime = now; deadline = now + 2500; lastProgress = now; log('open 30');
                } else if (now > deadline){
                    step = 11; lastTime = now; deadline = 0; lastProgress = now; log('30 skip');
                }
                return;
            }
            // 10) إغلاق بروفايل 30
            if (step === 10){
                if (profileOpen(d)){
                    if (now - lastTime > 400){
                        var cb2 = d.querySelector('#upro .fa-times');
                        if (cb2) cb2.click();
                        try { if (w.$) w.$('#upro').modal('hide'); } catch(e){}
                        step = 11; lastTime = now; deadline = 0; lastProgress = now; log('close 30');
                    }
                } else if (now > deadline){
                    step = 11; lastTime = now; deadline = 0; lastProgress = now;
                }
                return;
            }
            // 11) فتح الإعدادات
            if (step === 11){
                if (!isLoggedIn(d)){ step = 2; lastTime = now; deadline = 0; lastProgress = now; return; }
                var sb = d.querySelector('.th-d0-settings');
                if (sb) sb.click();
                step = 12; lastTime = now; deadline = 0; lastProgress = now; log('settings');
                return;
            }
            // 12) تسجيل الخروج الصامت
            if (step === 12){
                if (now - lastTime > 500){
                    var lb = d.querySelector('label.SERT');
                    if (lb){
                        lb.click(); // onclick="logout();" موجه لخروجنا الصامت
                    } else {
                        softLogout(w);
                    }
                    step = 13; lastTime = now; deadline = now + 4000; lastProgress = now; log('logout clicked');
                }
                return;
            }
            // 13) الانتظار حتى تظهر شاشة الدخول ثم دورة جديدة
            if (step === 13){
                var atLogin = !isLoggedIn(d);
                if (atLogin || now > deadline){
                    if (!atLogin){ showLogin(w); }
                    step = 2; lastTime = now; deadline = 0; lastProgress = now; log('restart cycle');
                }
                return;
            }
        } catch(e){}
    }

    // حارس أمان: لو توقف 20 ثانية يرجع لخطوة الدخول (بدون تحديث)
    setInterval(function(){
        if (Date.now() - lastProgress > 20000){
            log('watchdog recover');
            try { var w = W(); if (w) rearmSocket(w); } catch(e){}
            step = 2; lastTime = Date.now(); lastClick = 0; deadline = 0; lastProgress = Date.now();
        }
    }, 3000);

    setInterval(runBot, 60);
    alert('تم تشغيل البوت (نسخة جذرية ثابتة)');
})();
